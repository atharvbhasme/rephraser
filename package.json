{
  "name": "rephraser",
  "private": true,
  "version": "0.1.0",
  "description": "Offline English spelling & grammar corrector with an optional local rephraser. Runs entirely in the browser.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "postinstall": "node scripts/copy-ort-wasm.mjs",
    "check:system": "node scripts/check-system.mjs",
    "setup:rephrase": "node scripts/setup-rephrase-model.mjs",
    "remove:rephrase": "node scripts/remove-rephrase-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "harper.js": "3.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "onnxruntime-node": "file:./stubs/empty",
    "sharp": "file:./stubs/empty"
  }
}
